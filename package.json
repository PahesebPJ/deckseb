{
  "name": "deckseb",
  "version": "0.2.1",
  "description": "Minimalist instant plan viewer with live Markdown GFM & Mermaid rendering for *seb ecosystem",
  "keywords": [
    "deckseb",
    "hubseb",
    "crewseb",
    "memoseb",
    "plan-viewer",
    "mermaid",
    "markdown"
  ],
  "license": "MIT",
  "author": "PahesebPJ",
  "homepage": "https://github.com/PahesebPJ/deckseb#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PahesebPJ/deckseb.git"
  },
  "bugs": {
    "url": "https://github.com/PahesebPJ/deckseb/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "deckseb": "./dist/cli/deckseb.js"
  },
  "files": [
    "dist",
    "src/styles",
    "README.md",
    "AGENT_INSTALL.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"if (fs.existsSync('dist/cli/deckseb.js')) fs.chmodSync('dist/cli/deckseb.js', 0o755)\"",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.spec.ts\"",
    "deckseb": "node src/cli/deckseb.ts",
    "ui": "node src/cli/deckseb.ts ui"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.2"
  }
}
